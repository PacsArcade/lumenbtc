# Copy to .env and fill in. Never commit .env, it holds a live credential.

# Required: the Plow API root, without /v1 (plow-openclaw-agent README.md:51).
PLOW_API_BASE=

# Required for a local run: the token from `plow-agents mint LINE_UID`.
# A cloud host injects this instead.
PLOW_AGENT_TOKEN=

# Optional: put this install on the Agent Index (aiworthusing.com/agent-index).
# Without AGENT_ID, nothing is reported and nothing runs for it.
AGENT_ID=
AGENT_NAME=Lumen
AGENT_BLURB=Bitcoin and nostr attendant for Pac's Arcade installs. Setup guide, shop and event answers, never touches keys.

# Optional, OFF by default: see skills/attendant-letters/SKILL.md. The site
# endpoint this needs does not exist yet; leave unset or 0.
ATTENDANT_LETTERS_ENABLED=0
